# Excluir artefactos de build locales (Windows) para evitar que rutas
# del host contaminen el restore de NuGet dentro del contenedor Linux.
**/obj/
**/bin/

# Archivos de entorno y secretos
.env

# Artefactos de IDE y sistema operativo
.vs/
**/.idea/
*.user
**/.DS_Store
**/Thumbs.db

# Git
.git/
.gitignore

# Documentación legacy (no necesaria en la imagen)
legado/

# Tests (no se incluyen en la imagen de producción)
src/Polizas.Tests/
